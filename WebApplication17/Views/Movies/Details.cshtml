@model WebApplication17.Models.Movie

@{
    ViewData["Title"] = Model.Title;
}

<div class="card mt-4 col-md-6 mx-auto">
    <div class="card-header bg-dark text-white">
        <h3>@Model.Title</h3>
    </div>
    <div class="card-body">
        <p><strong>Жанр:</strong> @Model.Genre</p>
        <p><strong>Рік випуску:</strong> @Model.ReleaseYear</p>
        <p><strong>Рейтинг:</strong> <span class="badge bg-warning text-dark">★ @Model.Rating</span></p>
    </div>
    <div class="card-footer">
        <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
    </div>
</div>